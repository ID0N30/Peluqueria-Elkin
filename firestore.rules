rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isHardcodedAdmin() {
      return isAuthenticated() && 
        'email' in request.auth.token && (
          request.auth.token.email == 'jaompe@gmail.com' ||
          request.auth.token.email == 'peluqueriaelkin@gmail.com'
        );
    }

    function isSuperAdmin() {
      return isHardcodedAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
    }

    match /appointments/{appointmentId} {
      allow read, create: if true;
      allow update: if isAuthenticated() || 
                    request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'completedAt']);
      allow delete: if isSuperAdmin();
    }

    match /slots/{slotId} {
      allow read, write: if true;
    }

    match /config/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /blockedDates/{date} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }
  }
}
