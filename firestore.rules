rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isHardcodedAdmin() {
      return isAuthenticated() && 
        'email' in request.auth.token && (
          request.auth.token.email == 'jaomp3@gmail.com' ||
          request.auth.token.email == 'elkintabarez04@gmail.com'
        );
    }

    function isSuperAdmin() {
      return isHardcodedAdmin() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Perfiles de usuario: cada usuario solo lee y actualiza su propio perfil,
    // impidiendo la auto-asignación de roles privilegiados (role == 'admin').
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if isAuthenticated() && request.auth.uid == userId && (!('role' in request.resource.data) || request.resource.data.role == 'user' || isHardcodedAdmin());
      allow update: if isAuthenticated() && ((request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // Citas: protegidas estrictamente para superadministradores.
    // Clientes y WhatsApp operan a través del backend seguro (Firebase Admin SDK).
    match /appointments/{appointmentId} {
      allow read, write: if isSuperAdmin();
    }

    // Contadores diarios consolidados de disponibilidad
    match /dailySlots/{date} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Contadores individuales legacy por franja
    match /slots/{slotId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Configuración general del negocio (horarios, estilistas)
    match /config/{document=**} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Fechas bloqueadas / feriados
    match /blockedDates/{date} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Sesiones conversacionales del bot de WhatsApp (solo accesibles vía Admin SDK en backend)
    match /whatsappSessions/{phone} {
      allow read, write: if false;
    }
  }
}
